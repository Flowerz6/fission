# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ---- Tooling caches ----
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# ---- Secrets / local env ----
.env
.env.*
!.env.example
*.pem
*.key
client_secret*.json
service_account*.json
token*.json

# ---- Run artifacts & data (never commit) ----
out/
**/out/
*.db
*.db.backup*
*.sqlite
*.sqlite3
*.jsonl
# ...but test fixtures under tests/data/ are committed (CI needs them).
!tests/data/*.jsonl

# ---- Generated reports / media (regenerable) ----
*.pdf
*.png
*.mp4
*.zip
!docs/**/*.png

# ---- Playwright ----
.advtest/
playwright-profile/
**/playwright-profile/

# ---- OS / editor ----
.DS_Store
*.swp
.idea/
.vscode/

# ---- Productionisation cleanup (2026-09) ----
# Regenerable font cache used by the PDF/report scripts
scripts/.fontcache/
# Office deliverables are regenerable from scripts/ (pdf already ignored above)
*.docx
# Local DB backups directory
backups/
