# Fission env contract. Copy to `.env` for local use (git- + docker-ignored).
# In production DO NOT ship a .env — the platform (Cloud Run / GKE) injects
# these from a secret manager as environment variables; the app only reads env.
# Everything has a safe default except the assessment service key, so a bare dashboard runs
# with none of these set.

# ============================ SECRETS ============================
# Never commit. In prod, map each from GCP Secret Manager → env var.

# Content generation and assessment evaluation service.
ANTHROPIC_API_KEY=

# Dashboard bearer token. Unset = open (dev only). Set in any shared/prod deploy.
ADVTEST_DASHBOARD_TOKEN=

# Google Workspace access (ui_mode targets / corpus seeding).
ADVTEST_SA_KEY_PATH=            # path to the service-account JSON key file
ADVTEST_SA_IMPERSONATE=         # user to impersonate (domain-wide delegation)
ADVTEST_OAUTH_TOKEN_CACHE=      # path to the cached OAuth token (oauth_user flow); default ~/.advtest/oauth-token.json
ADVTEST_OAUTH_CLIENT_SECRETS=   # path to the client_secret*.json from Google Cloud Console; REQUIRED on the first oauth_user run
ADVTEST_AUTH_MODE=              # service_account | oauth_user — REQUIRED for any API-mode Workspace op

# ======================= DATASTORE / INFRA =======================
# Default is local SQLite + local-disk artifacts.

ADVTEST_DB_URL=                 # e.g. postgresql+psycopg://user:pw@host:5432/db
ADVTEST_ARTIFACT_BACKEND=       # local (default) | gcs
ADVTEST_ARTIFACT_BUCKET=        # required when backend=gcs
ADVTEST_ARTIFACT_PREFIX=        # optional object-key prefix

# ========================== CONFIG =============================
# Non-secret tuning; safe defaults exist for all.

ADVTEST_PROVIDER_CONFIG=        # absolute path to the providers YAML (default configs/dev.yaml)
ADVTEST_ENABLE_LIVE_TESTS=      # 1 enables New assessment launch actions locally

# ui_mode (browser) workers
ADVTEST_PLAYWRIGHT_PROFILE_DIR= # persistent signed-in Chrome profile dir
ADVTEST_PLAYWRIGHT_TIMEOUT=     # selector wait, ms (default 20000)
ADVTEST_PLAYWRIGHT_SLOWMO_MS=   # per-action delay, ms (demos)
ADVTEST_BROWSER_WINDOW_X=640       # dock runner on the right of a 1920px display
ADVTEST_BROWSER_WINDOW_Y=0
ADVTEST_BROWSER_WINDOW_WIDTH=1280
ADVTEST_BROWSER_WINDOW_HEIGHT=1040

# Per-account profile dirs for the account pool
ADVTEST_PROFILE_GMAIL_SENDER=
ADVTEST_PROFILE_OUTLOOK_SENDER=
ADVTEST_PROFILE_ATTACKER_SENDER=   # Chrome profile for the attacker mailbox (UI setup steps)
ADVTEST_PROFILE_BYSTANDER=

# Per-account OAuth token caches for API-based setup ops (e.g. gmail.send_email
# planting the bait email AS the attacker). A guide's setup steps resolve each
# role to its own token here; unset falls back to the ~/.advtest defaults.
# The recipient/default token is ADVTEST_OAUTH_TOKEN_CACHE (above).
ADVTEST_OAUTH_TOKEN_ATTACKER_SENDER=   # default: ~/.advtest/oauth-token-attacker-sender.json
ADVTEST_OAUTH_TOKEN_BYSTANDER=         # default: ~/.advtest/oauth-token-bystander.json

# Retrieval-verdict run parameters (per-engagement)
ADVTEST_RV_ENTITY=
ADVTEST_RV_CANARY=
ADVTEST_RV_HANDSHAKE=

# Attack tuning
ADVTEST_PAIR_MAX_ROUNDS=        # PAIR refinement rounds
